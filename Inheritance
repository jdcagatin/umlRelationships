class Vehicle:
    def __init__(self, make: str):
        self.make = make  # Public attribute

    def drive(self):
        print(f"The {self.make} is moving forward.")

# Car inherits from Vehicle
class Car(Vehicle):
    def __init__(self, make: str, doors: int):
        # Call the parent class constructor using super()
        super().__init__(make) 
        self.doors = doors

    def honk(self):
        print("Beep beep!")

# Usage Example
my_car = Car(make="Toyota", doors=4)
my_car.drive()  # Inherited method execution
my_car.honk()   # Subclass-specific method execution
